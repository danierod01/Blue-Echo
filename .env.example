# ============================================================
# Blue-Echo — Variables de entorno
# Copia este fichero como .env y rellena tus API keys.
# NUNCA subas .env al repositorio.
# ============================================================

# ---- Threat Intelligence APIs ----
VT_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
OTX_API_KEY=
GREYNOISE_API_KEY=

# ---- IA Generativa (obligatorio para el análisis en lenguaje natural) ----
ANTHROPIC_API_KEY=

# ---- Autenticación (opcional) ----
# Si se define, todas las rutas de la API (excepto /health) exigen este header:
#   X-API-Key: <valor>
# Si se deja en blanco, la autenticación está desactivada (útil en desarrollo local).
BLUE_ECHO_API_KEY=

# ---- Backend ----
DATABASE_URL=sqlite:///./ioc_correlator.db
REQUEST_TIMEOUT=10
MAX_CONCURRENT_REQUESTS=5
CACHE_TTL_SECONDS=3600
# En producción, pon aquí la IP o dominio del servidor (ej: http://65.21.x.x o https://tudominio.com)
# En local puedes dejarlo en blanco o poner *
CORS_ORIGINS=*

# ---- Frontend (usado en tiempo de build de Vite) ----
VITE_API_BASE_URL=http://localhost:8000
# Debe coincidir con BLUE_ECHO_API_KEY del backend. Déjalo en blanco si no usas auth.
VITE_API_KEY=
