# ============================================================
# Blue-Echo — Variables de entorno
# Copia este fichero como .env y rellena tus API keys.
# NUNCA subas .env al repositorio.
# ============================================================

# ---- Threat Intelligence APIs — fuentes originales ----
VT_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
OTX_API_KEY=

# ---- Threat Intelligence APIs — nuevas fuentes ----
# ThreatFox (abuse.ch): API pública, key opcional para mayor cuota
THREATFOX_API_KEY=
# IPinfo: registro gratuito en ipinfo.io — 50.000 req/mes
IPINFO_API_KEY=
# SecurityTrails: registro gratuito en securitytrails.com — 2.500 req/mes
SECURITYTRAILS_API_KEY=
# Hybrid Analysis: registro en hybrid-analysis.com, solicitar tier "default"
HYBRID_ANALYSIS_API_KEY=
# Netlas: registro gratuito en netlas.io — 50 req/día
NETLAS_API_KEY=
# Criminal IP: registro gratuito en criminalip.io — créditos limitados
CRIMINAL_IP_API_KEY=
# MalShare: registro gratuito en malshare.com
MALSHARE_API_KEY=
# Pulsedive: registro gratuito en pulsedive.com — ATENCIÓN: solo 10 req/día
PULSEDIVE_API_KEY=
# Censys: registro gratuito en censys.io — ATENCIÓN: solo 250 req/mes
# Requiere dos credenciales separadas (API ID y API Secret)
CENSYS_API_ID=
CENSYS_API_SECRET=
# URLScan.io: API de búsqueda pública (sin key). Key opcional en urlscan.io para mayor cuota.
URLSCAN_API_KEY=

# ---- IA Generativa ----
# Groq (proveedor principal — tier gratuito, registro en console.groq.com)
# Modelo por defecto: llama-3.3-70b-versatile. Otras opciones: llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude (fallback opcional — de pago)
ANTHROPIC_API_KEY=

# ---- Autenticación (opcional) ----
# Si se define, todas las rutas de la API (excepto /health) exigen este header:
#   X-API-Key: <valor>
# Si se deja en blanco, la autenticación está desactivada (útil en desarrollo local).
BLUE_ECHO_API_KEY=

# ---- Rate limiting ----
# Peticiones máximas por IP y minuto a los endpoints de escaneo (default: 10)
RATE_LIMIT_SCAN=10
# Peticiones máximas por IP y minuto al resto de endpoints (default: 60)
RATE_LIMIT_DEFAULT=60

# ---- Backend ----
DATABASE_URL=sqlite:///./ioc_correlator.db
REQUEST_TIMEOUT=10
MAX_CONCURRENT_REQUESTS=5
CACHE_TTL_SECONDS=3600
# Tamaño máximo de fichero en uploads (MB). Sincronizar con client_max_body_size en nginx.conf.
MAX_UPLOAD_SIZE_MB=10
# En producción, pon aquí la IP o dominio del servidor (ej: http://65.21.x.x o https://tudominio.com)
# En local puedes dejarlo en blanco o poner *
CORS_ORIGINS=*

# ---- Frontend (usado en tiempo de build de Vite) ----
VITE_API_BASE_URL=http://localhost:8000
# Debe coincidir con BLUE_ECHO_API_KEY del backend. Déjalo en blanco si no usas auth.
VITE_API_KEY=
